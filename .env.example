# configurazione del ponte dati Claude Code → display tondo
# Copia in  .env  (che NON va committato: è nel .gitignore) e adatta i valori.

# Dove sta il file di credenziali di Claude Code.
# Il token viene letto a runtime da qui: NON va incollato in questo file.
CLAUDE_CREDENTIALS=/home/rob/.claude/.credentials.json

# Opzionale: token esplicito, solo per prove. Se valorizzato ha la precedenza
# sul file di credenziali. Lasciare vuoto in condizioni normali.
CLAUDE_OAUTH_TOKEN=

# Interfaccia e porta di ascolto (0.0.0.0 = visibile sulla LAN)
HOST=0.0.0.0
PORT=8790

# Ogni quanto interrogare l'endpoint, in secondi
POLL_SECONDS=60

# Oltre questo numero di secondi senza aggiornamenti il dato è "vecchio"
STALE_SECONDS=300

# Endpoint di utilizzo (quello che usa `claude /usage`)
USAGE_URL=https://api.anthropic.com/api/oauth/usage
